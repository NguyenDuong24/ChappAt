rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      let group = firestore.get(/databases/(default)/documents/groups/$(groupId)).data;
      return isAuthenticated() &&
        ((('members' in group) && request.auth.uid in group.members) ||
         (('memberIds' in group) && request.auth.uid in group.memberIds));
    }

    function isHotSpotChatParticipant(chatId) {
      return isAuthenticated() &&
        request.auth.uid in firestore.get(/databases/(default)/documents/hotSpotChats/$(chatId)).data.participants;
    }

    function isImageUpload(maxBytes) {
      return request.resource != null &&
        request.resource.size <= maxBytes &&
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');
    }

    function isAudioUpload(maxBytes) {
      return request.resource != null &&
        request.resource.size <= maxBytes &&
        request.resource.contentType.matches('audio/(mpeg|mp3|mp4|aac|wav|x-wav|m4a|x-m4a|3gpp)');
    }

    // Public signup avatar catalog. Users can browse and choose these icons,
    // but only server/admin tooling should upload or modify them.
    match /Icons/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Allow users to upload their own profile images
    match /profile-images/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageUpload(5 * 1024 * 1024);
    }

    // Profile-owned media used by edit profile cover uploads: users/{uid}/cover_*.jpg
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageUpload(5 * 1024 * 1024);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Allow users to upload chat images (only to their own directory)
    match /chat-images/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageUpload(4 * 1024 * 1024);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Allow users to upload chat audio (only to their own directory)
    match /chat-audio/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId && isAudioUpload(3 * 1024 * 1024);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Group media standardized paths
    match /groups/{groupId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isGroupMember(groupId) && isImageUpload(4 * 1024 * 1024);
      allow delete: if isGroupMember(groupId);
    }

    match /group-images/{groupId}/{allPaths=**} {
      allow read: if isGroupMember(groupId);
      allow write: if isGroupMember(groupId) && isImageUpload(5 * 1024 * 1024);
      allow delete: if isGroupMember(groupId);
    }

    // HotSpot chat images uploaded by the mobile app are scoped by owner first.
    // This keeps uploads reliable even before Storage has to read the chat doc.
    match /hotspot-chat-images/{userId}/{chatId}/{allPaths=**} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isHotSpotChatParticipant(chatId));
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageUpload(4 * 1024 * 1024);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Legacy HotSpot chat image path: hotspot-chat-images/{chatId}/{file}
    match /hotspot-chat-images/{chatId}/{allPaths=**} {
      allow read: if isHotSpotChatParticipant(chatId);
      allow write: if isHotSpotChatParticipant(chatId) && isImageUpload(4 * 1024 * 1024);
      allow delete: if isHotSpotChatParticipant(chatId);
    }

    // Allow users to upload their own images
    match /images/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageUpload(5 * 1024 * 1024);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Quarantine images blocked by client-side moderation before publishing.
    // Only admins can read these images from moderation tooling.
    match /flagged-content/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageUpload(5 * 1024 * 1024);
      allow delete: if false;
    }

    // Allow users to upload postcard media
    match /postcards/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageUpload(5 * 1024 * 1024);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
