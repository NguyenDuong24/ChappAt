# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to Git!

# Google Sign-In Configuration
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com

# Facebook Configuration
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_CLIENT_TOKEN=your_facebook_client_token
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Firebase Configuration (if you want to use env variables)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Development/Production Environment
NODE_ENV=development

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemma-4-26b-a4b-it:free

# Saigon Dating Express API used by Expo client
EXPO_PUBLIC_SAIGON_SERVER_API_URL=https://saigondating-server.onrender.com/api

# Firebase email verification. This HTTPS URL must be allowlisted in Firebase
# Authentication > Settings > Authorized domains.
EXPO_PUBLIC_EMAIL_VERIFY_CONTINUE_URL=https://your-app.com/auth/email-verified
EXPO_PUBLIC_ANDROID_PACKAGE_NAME=saigondating.com.vn
EXPO_PUBLIC_IOS_BUNDLE_ID=saigondating.com.vn

# VideoSDK secrets must be set only on saigondating-server, never as EXPO_PUBLIC_*
VIDEOSDK_API_KEY=your_videosdk_api_key
VIDEOSDK_SECRET_KEY=your_videosdk_secret_key
VIDEOSDK_DAILY_CALLS_FREE=20
VIDEOSDK_DAILY_CALLS_PREMIUM=120
VIDEOSDK_CREATE_COOLDOWN_SECONDS=20
VIDEOSDK_JOIN_TOKEN_TTL_MINUTES=30
VIDEOSDK_ROOM_CREATE_TOKEN_TTL_MINUTES=10
VIDEOSDK_MAX_DURATION_SECONDS_FREE=600
VIDEOSDK_MAX_DURATION_SECONDS_PREMIUM=2700
VIDEOSDK_TOKEN_RATE_MAX=80
VIDEOSDK_ROOM_RATE_MAX=6
